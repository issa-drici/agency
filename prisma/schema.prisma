// Schéma aligné sur NextAuth (PrismaAdapter) + `pnpm db:migrate` / `pnpm migrate`.
// Accès : `import { prisma } from "@/lib/db"`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?   @map("first_name")
  email         String    @unique
  phone         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

/// Messages WhatsApp / agent (identifiants par numéro prospect E.164).
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id")
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@map("conversations")
}

model NotePO {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id")
  contenu   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@map("notes_po")
}

model UserStory {
  id                  String   @id @default(uuid()) @db.Uuid
  clientId            String   @map("client_id")
  titre               String   @db.VarChar(200)
  description         String?  @db.Text
  criteresAcceptance  String?  @db.Text @map("criteres_acceptance")
  contexte            String?  @db.Text
  horsScope           String?  @db.Text @map("hors_scope")
  dependances         String?  @db.Text
  type                String?  @db.VarChar(20)
  specsTechniques     String?  @db.Text @map("specs_techniques")
  usParentId          String?  @db.Uuid @map("us_parent_id")
  statut              String   @default("backlog")
  priorite            Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("user_stories")
}

/// Audit / roadmap / V1 (JSON stringifié), un enregistrement par prospect WhatsApp.
model Livrable {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @unique @map("client_id")
  audit     String?  @db.Text
  roadmap   String?  @db.Text
  v1        String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("livrables")
}

/// Sessions NextAuth (JWT + adapter : lignes peu utilisées, mais requises par l’adaptateur).
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("next_auth_sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         BigInt? @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}
